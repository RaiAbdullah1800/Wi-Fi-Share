# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class

# Runtime configuration & private passwords
config.json

# Storage folder contents (except .gitkeep)
shared_storage/*
!shared_storage/.gitkeep
public_shares/*
!public_shares/.gitkeep

# System & IDE temp files
.DS_Store
.vscode/
.idea/
*.log
